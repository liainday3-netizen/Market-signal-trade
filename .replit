modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"  # ⚠ switch to Reserved VM in the Replit Deploy UI for 24/7 — see DEPLOY.md

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]

# Secrets (COINBASE_API_KEY, COINBASE_API_SECRET, DEX_WALLET_PRIVATE_KEY,
# ADMIN_TOKEN, TELEGRAM_*, ...) belong in Replit's Secrets tool — never in this
# file, which is committed to git. See .env.example and DEPLOY.md.
