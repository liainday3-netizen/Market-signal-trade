# ─── Copy to .env (Docker/VPS) or add each to Replit Secrets. NEVER commit real values. ───

# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=8080
NODE_ENV=production

# Protects all control endpoints (start/stop, live mode, wallet, risk, kill switch).
# Generate with:  openssl rand -hex 32
ADMIN_TOKEN=

# ─── Real-money arm ───────────────────────────────────────────────────────────
# Must be exactly "true" before the bot will OPEN any real position.
# Leave unset/false for paper trading. Exits on existing positions always run.
LIVE_TRADING_ENABLED=false

# Emergency stop that overrides the dashboard: set to 1 and restart.
KILL_SWITCH=

# ─── Coinbase Advanced Trade (CEX) ────────────────────────────────────────────
# Create a NEW key with "trade" + "view" permission only — NO withdraw/transfer.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ─── Base chain DEX (Uniswap v3) ──────────────────────────────────────────────
# Use a dedicated hot wallet holding only what you are willing to lose.
DEX_WALLET_PRIVATE_KEY=

# ─── Alerts (optional but strongly recommended) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
BOT_NAME=market-signal-trade

# Lock read-only dashboard data (balances, trades, PnL) behind ADMIN_TOKEN too.
PROTECT_READS=false
LOG_LEVEL=info
